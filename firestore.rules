rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() 
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && getUserData().role == 'admin';
    }

    // ── Users Collection ──
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) 
                    && (!request.resource.data.keys().hasAny(['role']) 
                        || request.resource.data.role in ['user', 'owner']);

      allow update: if (isOwner(userId) 
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) 
                            || isAdmin()))
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // ── Vehicles / Cars Collection ──
    match /cars/{carId} {
      // Anyone can browse vehicles and see rating info
      allow read: if true;

      // Authenticated users can list cars
      allow create: if isAuthenticated();

      // Authenticated users can update car (owners edit specs, borrowers update availability or ratings)
      allow update: if isAuthenticated();

      // Only car owner or admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        isAdmin()
      );
    }

    // ── Rentals / Bookings Collection ──
    match /rentals/{rentalId} {
      // Borrowers, Owners, and Admins can read
      allow read: if isAuthenticated();

      // Authenticated users can create bookings
      allow create: if isAuthenticated();

      // Borrowers, owners, and admins can update (cancel, accept, complete, mark rated)
      allow update: if isAuthenticated();

      allow delete: if isAdmin();
    }

    // ── Reviews & Ratings Collection ──
    match /reviews/{reviewId} {
      // Anyone can read reviews and ratings before renting
      allow read: if true;

      // Any authenticated user can submit a review
      allow create: if isAuthenticated();

      // Author or admin can update/delete
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ── Payments Collection ──
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
